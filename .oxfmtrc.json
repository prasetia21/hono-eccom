{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxfmt/configuration_schema.json",
  "indentStyle": "space",
  "indentWidth": 2,
  "lineWidth": 120,
  "semicolons": "asNeeded",
  "quoteStyle": "single",
  "trailingCommas": "all",
  "ignorePatterns": ["dist", "node_modules", "pnpm-lock.yaml"]
}
