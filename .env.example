# Application
NODE_ENV=development
APP_HOST=http://localhost
APP_PORT=9001
LOG_LEVEL=debug
APP_NAME="Service App eBelanja Ecommerce Hono"
APP_KEY=
API_PATH=app-v5
API_VERSION=

DOCS_PATH=api/docs

LOG_LEVEL=debug
LOG_STORE=false

SECRET_KEY=""
APP_API_KEY=""
APP_SESSION_EXPIRATION=180

# Database (PostgreSql)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ebelanja_db
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_ENABLE_LOGGING=false

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_KEY_PREFIX="Belanja Pasti"

# Auth
JWT_SECRET=your-super-secret-key-minimum-32-characters-required!!
JWT_EXPIRES_IN=7d

# AWS S3 / MinIO
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_ENDPOINT=

# SMTP / Nodemailer
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-ethereal-user@ethereal.email
SMTP_PASS=your-ethereal-password
SMTP_FROM="Hono API" <no-reply@example.com>

FCM_PROJECT_ID=belanja-pasti
FCM_API_ACCESS_KEY=
GOOGLE_CLIENT_ID=

# Email Service
SENDGRID_API_KEY=
SENDINBLUE_API_KEY=
MAILJET_PUBLIC_KEY=
MAILJET_PRIVATE_KEY=

# XFERS
XFERS_SECRET=
XFERS_API_KEY=
XFERS_URL=

# XENDIT
XENDIT_SECRET_KEY=
XENDIT_PREFIX=
XENDIT_CALLBACK_TOKEN=
XENDIT_URL=

