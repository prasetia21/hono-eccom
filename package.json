{
  "name": "service-app-ecommerce",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsdown src/index.ts --format esm --out-dir dist --clean --minify",
    "start": "node dist/index.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxlint --write .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "format:fix": "oxfmt --write .",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "check:fix": "npm run typecheck && npm run lint:fix && npm run format",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:modules": "vitest run src/modules/",
    "test:modules:watch": "vitest src/modules/",
    "test:global": "vitest run test/",
    "test:global:watch": "vitest test/",
    "test:integration": "vitest run test/integration/",
    "test:integration:watch": "vitest test/integration/",
    "test:module": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1093.0",
    "@hono-rate-limiter/redis": "^0.1.4",
    "@hono/node-server": "^2.0.11",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.5.1",
    "@hono/zod-validator": "^0.9.0",
    "bullmq": "^5.80.11",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "google-auth-library": "^11.1.0",
    "hono": "^4.12.31",
    "hono-rate-limiter": "^0.5.3",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "redis": "^6.1.0",
    "tsdown": "^0.22.14",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "^0.31.10",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24"
  }
}
